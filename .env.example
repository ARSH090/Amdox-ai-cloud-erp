# ════════════════════════════════════════════════════════
# AMX-ERP-2026-04 | ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════

# ── 1. GLOBAL SETTINGS ──────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── 2. DATABASE (TimescaleDB / PostgreSQL) ──────────
POSTGRES_DB=amdox_erp
POSTGRES_USER=amdox_admin
POSTGRES_PASSWORD=amdox_super_secure_pg_pass
DATABASE_URL=postgresql://amdox_admin:amdox_super_secure_pg_pass@postgres:5432/amdox_erp?schema=public

# ── 3. REDIS (Cache / Queue / Rate Limiting) ────────
REDIS_PASSWORD=amdox_redis_secret
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:amdox_redis_secret@redis:6379/0

# ── 4. KEYCLOAK (Identity / Auth) ───────────────────
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/amdox_erp
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_pass
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=amdox-erp
KEYCLOAK_CLIENT_ID=amdox-web-client

# ── 5. ELASTICSEARCH ────────────────────────────────
ELASTIC_PASSWORD=amdox_elastic_pass
ELASTIC_URL=http://elasticsearch:9200

# ── 6. AWS SERVICES (S3 / SES / Textract) ───────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=amdox-erp-assets

# ── 7. ML SERVICE ───────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
ML_SERVICE_URL=http://ml-service:8000
