generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RoleType {
  SuperAdmin
  TenantAdmin
  Manager
  Viewer
}

// ── CORE SYSTEM ──────────────────────────────────────────────────────────

model Tenant {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String       @unique
  name          String
  plan          String
  keycloakRealm String       @unique
  activationId  String?      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status        TenantStatus @default(PENDING)
  settings      Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  users         User[]
  roles         Role[]
}

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  keycloakSub String
  email       String
  fullName    String
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  roles       UserRole[]

  @@unique([tenantId, keycloakSub])
}

model Role {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  name        RoleType
  permissions Json       @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]

  @@unique([tenantId, name])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  grantedBy String?  @db.Uuid
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ── FINANCE MODULE ───────────────────────────────────────────────────────

model Account {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @db.Uuid
  code      String
  name      String
  type      String // asset, liability, equity, revenue, expense
  currency  String        @db.Char(3)
  parentId  String?       @db.Uuid
  parent    Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]     @relation("AccountHierarchy")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lines     JournalLine[]
}

model FiscalPeriod {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date
  status    String // open, closed, locked
  closedBy  String?        @db.Uuid
  closedAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries   JournalEntry[]
  lock      PeriodLock?
}

model PeriodLock {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String       @db.Uuid
  periodId   String       @unique @db.Uuid
  period     FiscalPeriod @relation(fields: [periodId], references: [id])
  lockedBy   String       @db.Uuid
  lockedAt   DateTime     @default(now())
  reason     String?
  unlockedBy String?      @db.Uuid
  unlockedAt DateTime?
}

model JournalEntry {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @db.Uuid
  periodId    String        @db.Uuid
  period      FiscalPeriod  @relation(fields: [periodId], references: [id])
  reference   String?
  description String
  currency    String        @db.Char(3)
  fxRate      Decimal       @db.Decimal(18, 6)
  postedBy    String        @db.Uuid
  postedAt    DateTime      @default(now())
  isReversed  Boolean       @default(false)
  reversalOf  String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lines       JournalLine[]
}

model JournalLine {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String       @db.Uuid
  entry       JournalEntry @relation(fields: [entryId], references: [id])
  accountId   String       @db.Uuid
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Decimal      @db.Decimal(20, 6)
  credit      Decimal      @db.Decimal(20, 6)
  description String?
  reference   String?
}

model ExchangeRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  baseCurrency   String   @db.Char(3)
  targetCurrency String   @db.Char(3)
  rate           Decimal  @db.Decimal(18, 6)
  source         String
  rateDate       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SupplierInvoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  vendorId      String   @db.Uuid
  invoiceNumber String
  amount        Decimal  @db.Decimal(20, 6)
  currency      String   @db.Char(3)
  status        String // pending, matched, paid, rejected
  dueDate       DateTime @db.Date
  ocrRawData    Json?
  s3Key         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
}

// ── HR MODULE ────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  managerId String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  employeeNumber String
  fullName       String
  email          String
  jobTitle       String
  departmentId   String?   @db.Uuid
  managerId      String?   @db.Uuid
  employmentType String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  baseSalary     Decimal?  @db.Decimal(20, 6)
  currency       String    @default("USD") @db.Char(3)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, employeeNumber])
}

model LeaveType {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  daysPerYear  Decimal  @db.Decimal(10, 2)
  carryOverMax Decimal  @db.Decimal(10, 2)
  isPaid       Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeaveBalance {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @db.Uuid
  leaveTypeId String   @db.Uuid
  year        Int
  allocated   Decimal  @db.Decimal(10, 2)
  taken       Decimal  @db.Decimal(10, 2)
  remaining   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String    @db.Uuid
  leaveTypeId String    @db.Uuid
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  status      String // pending, approved, rejected, cancelled
  approverId  String?   @db.Uuid
  approvedAt  DateTime?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AttendanceRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @db.Uuid
  date          DateTime  @db.Date
  clockIn       DateTime? @db.Timestamptz
  clockOut      DateTime? @db.Timestamptz
  overtimeHours Decimal   @default(0) @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TaxSlab {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  slabName      String
  minIncome     Decimal  @db.Decimal(20, 6)
  maxIncome     Decimal? @db.Decimal(20, 6)
  rate          Decimal  @db.Decimal(5, 4)
  jurisdiction  String
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PayrollRun {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  periodName  String
  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  status      String // pending, processing, completed, failed
  initiatedBy String    @db.Uuid
  completedAt DateTime?
  totalGross  Decimal?  @db.Decimal(20, 6)
  totalNet    Decimal?  @db.Decimal(20, 6)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payslip {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId String   @db.Uuid
  employeeId   String   @db.Uuid
  grossPay     Decimal  @db.Decimal(20, 6)
  netPay       Decimal  @db.Decimal(20, 6)
  deductions   Json     @default("{}")
  pdfS3Key     String?
  isEncrypted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── SUPPLY CHAIN MODULE ──────────────────────────────────────────────────

model Vendor {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  email     String?
  phone     String?
  address   Json?
  rating    Decimal?  @db.Decimal(3, 2)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  location  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @db.Uuid
  sku               String
  name              String
  description       String?
  unitCost          Decimal   @db.Decimal(20, 6)
  currency          String    @db.Char(3)
  reorderPoint      Decimal   @db.Decimal(20, 6)
  reorderQty        Decimal   @db.Decimal(20, 6)
  preferredVendorId String?   @db.Uuid
  autoDraftEnabled  Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, sku])
}

model InventoryLevel {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @db.Decimal(20, 6)
  reservedQty Decimal  @default(0) @db.Decimal(20, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemId, warehouseId])
}

model PurchaseOrder {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  vendorId       String    @db.Uuid
  orderNumber    String
  status         String // draft, pending_approval, approved, sent, received, cancelled
  totalAmount    Decimal   @db.Decimal(20, 6)
  currency       String    @db.Char(3)
  notes          String?
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PurchaseOrderLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String   @db.Uuid
  itemId          String   @db.Uuid
  qtyOrdered      Decimal  @db.Decimal(20, 6)
  unitPrice       Decimal  @db.Decimal(20, 6)
  totalPrice      Decimal  @db.Decimal(20, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GoodsReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  purchaseOrderId String   @db.Uuid
  receivedBy      String   @db.Uuid
  receivedAt      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReceiptLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId        String   @db.Uuid
  poLineId         String   @db.Uuid
  quantityReceived Decimal  @db.Decimal(20, 6)
  unitCost         Decimal  @db.Decimal(20, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FinancialMatching {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  invoiceId        String   @db.Uuid
  purchaseOrderId  String   @db.Uuid
  goodsReceiptId   String   @db.Uuid
  status           String
  quantityVariance Decimal  @db.Decimal(10, 4)
  amountVariance   Decimal  @db.Decimal(20, 6)
  matchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── PROJECTS MODULE ──────────────────────────────────────────────────────

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  code        String
  name        String
  description String?
  budget      Decimal   @db.Decimal(20, 6)
  actualCost  Decimal   @default(0) @db.Decimal(20, 6)
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  status      String // planning, in_progress, on_hold, completed, cancelled
  managerId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Milestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String    @db.Uuid
  name        String
  dueDate     DateTime  @db.Date
  status      String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String    @db.Uuid
  milestoneId    String?   @db.Uuid
  name           String
  description    String?
  status         String
  assigneeId     String?   @db.Uuid
  estimatedHours Decimal   @default(0) @db.Decimal(6, 2)
  actualHours    Decimal   @default(0) @db.Decimal(6, 2)
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  parentTaskId   String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TaskDependency {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String   @db.Uuid
  dependsOnTaskId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([taskId, dependsOnTaskId])
}

model ResourceAllocation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String    @db.Uuid
  taskId         String?   @db.Uuid
  employeeId     String    @db.Uuid
  allocatedHours Decimal   @db.Decimal(6, 2)
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ── AUDIT & BI MODULES ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  payload   String
  prevHash  String?
  hash      String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
}

model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  recipientId  String    @db.Uuid
  channel      String // email, sms, in_app, webhook
  subject      String
  body         String
  status       String // pending, sent, failed
  retryCount   Int       @default(0)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Dashboard {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  isPublic  Boolean  @default(false)
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardWidget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  dashboardId String   @db.Uuid
  widgetType  String
  config      Json
  position    Json
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  email      String
  company    String
  status     String
  source     String
  assigneeId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TerminalLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  command    String
  output     String?
  executedAt DateTime @default(now())
}

// ── ADDITIONAL MODULES (ADDED FROM BLUEPRINT) ────────────────────────────

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model Customer {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  email     String?
  phone     String?
  address   Json?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  invoiceId     String?  @db.Uuid
  amount        Decimal  @db.Decimal(20, 6)
  currency      String   @db.Char(3)
  paymentDate   DateTime @db.Date
  paymentMethod String
  reference     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseRequisition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  requesterId  String   @db.Uuid
  departmentId String?  @db.Uuid
  status       String // pending, approved, rejected, converted
  totalAmount  Decimal? @db.Decimal(20, 6)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StockMovement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  itemId      String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @db.Decimal(20, 6)
  type        String // in, out, adjustment, transfer
  reference   String?
  createdAt   DateTime @default(now())
}

model Budget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  projectId   String   @db.Uuid
  amount      Decimal  @db.Decimal(20, 6)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Forecast {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  itemId          String   @db.Uuid
  forecastDate    DateTime @db.Date
  predictedDemand Decimal  @db.Decimal(20, 6)
  confidenceLow   Decimal? @db.Decimal(20, 6)
  confidenceHigh  Decimal? @db.Decimal(20, 6)
  modelConfig     Json?
  createdAt       DateTime @default(now())
}

model FileObject {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  uploadedBy String   @db.Uuid
  fileName   String
  fileSize   Int
  mimeType   String
  s3Key      String
  entityType String?
  entityId   String?  @db.Uuid
  createdAt  DateTime @default(now())
}
