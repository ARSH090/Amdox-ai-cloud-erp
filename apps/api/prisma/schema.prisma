// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ════════════════════════════════════════════════════════
// 1. CORE SYSTEM & MULTI-TENANCY
// ════════════════════════════════════════════════════════

model Tenant {
  id             String      @id @default(uuid()) @db.Uuid
  slug           String      @unique
  name           String
  plan           String      @default("trial") // trial | starter | enterprise
  keycloakRealm  String      @unique @map("keycloak_realm")
  isActive       Boolean     @default(true) @map("is_active")
  settings       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users          User[]
  roles          Role[]
  accounts       Account[]
  fiscalPeriods  FiscalPeriod[]
  journalEntries JournalEntry[]
  employees      Employee[]
  leaveTypes     LeaveType[]
  payrollRuns    PayrollRun[]
  vendors        Vendor[]
  warehouses     Warehouse[]
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  projects       Project[]
  leads          Lead[]
  terminalLogs   TerminalLog[]

  @@map("tenants")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  keycloakSub  String       @map("keycloak_sub")
  email        String
  fullName     String       @map("full_name")
  avatarUrl    String?      @map("avatar_url")
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  employees    Employee[]
  postedEntries JournalEntry[]
  fiscalPeriods FiscalPeriod[] // Closed by user relation
  payrollRuns  PayrollRun[]   // Initiated by relation
  goodsReceipts GoodsReceipt[] // Received by relation
  terminalLogs  TerminalLog[]

  @@unique([tenantId, keycloakSub])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([keycloakSub])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  permissions Json       @default("[]")
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ════════════════════════════════════════════════════════
-- 2. FINANCE MODULE
// ════════════════════════════════════════════════════════

model Account {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  code      String
  name      String
  type      String // asset | liability | equity | revenue | expense
  currency  String        @default("USD") @db.Char(3)
  parentId  String?       @map("parent_id") @db.Uuid
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]     @relation("AccountHierarchy")
  lines     JournalLine[]

  @@unique([tenantId, code])
  @@map("accounts")
}

model FiscalPeriod {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime       @map("start_date") @db.Date
  endDate   DateTime       @map("end_date") @db.Date
  status    String         @default("open") // open | closed | locked
  closedBy  String?        @map("closed_by") @db.Uuid
  closedAt  DateTime?      @map("closed_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [closedBy], references: [id])
  entries   JournalEntry[]

  @@unique([tenantId, startDate])
  @@map("fiscal_periods")
}

model JournalEntry {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  periodId    String        @map("period_id") @db.Uuid
  reference   String?
  description String
  currency    String        @db.Char(3)
  fxRate      Decimal       @default(1.0) @map("fx_rate") @db.Decimal(18,6)
  postedBy    String        @map("posted_by") @db.Uuid
  postedAt    DateTime      @default(now()) @map("posted_at") @db.Timestamptz
  isReversed  Boolean       @default(false) @map("is_reversed")
  reversalOf  String?       @map("reversal_of") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period      FiscalPeriod  @relation(fields: [periodId], references: [id])
  user        User          @relation(fields: [postedBy], references: [id])
  lines       JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(uuid()) @db.Uuid
  entryId     String       @map("entry_id") @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  debit       Decimal      @default(0) @db.Decimal(20,6)
  credit      Decimal      @default(0) @db.Decimal(20,6)
  description String?

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

// ════════════════════════════════════════════════════════
-- 3. HR MODULE
// ════════════════════════════════════════════════════════

model Employee {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  userId         String?              @map("user_id") @db.Uuid
  employeeNumber String               @map("employee_number")
  fullName       String               @map("full_name")
  email          String
  departmentId   String?              @map("department_id") @db.Uuid
  managerId      String?              @map("manager_id") @db.Uuid
  jobTitle       String               @map("job_title")
  employmentType String               @map("employment_type") // full_time | part_time | contractor
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime?            @map("end_date") @db.Date
  baseSalary     Decimal?             @map("base_salary") @db.Decimal(20,6)
  currency       String               @default("USD") @db.Char(3)
  isActive       Boolean              @default(true) @map("is_active")
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id])
  manager        Employee?            @relation("ManagementChain", fields: [managerId], references: [id])
  subordinates   Employee[]           @relation("ManagementChain")
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  payslips       Payslip[]
  allocations    ResourceAllocation[]
  tasks          Task[]

  @@unique([tenantId, employeeNumber])
  @@map("employees")
}

model LeaveType {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  name             String
  accrualDays      Decimal        @map("accrual_days") @db.Decimal(5,2)
  maxCarryForward  Decimal        @default(0) @map("max_carry_forward") @db.Decimal(5,2)
  isPaid           Boolean        @default(true) @map("is_paid")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  leaveTypeId String    @map("leave_type_id") @db.Uuid
  balance     Decimal   @default(0) @db.Decimal(5,2)
  year        Int       @db.SmallInt
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  leaveTypeId   String    @map("leave_type_id") @db.Uuid
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime  @map("end_date") @db.Date
  daysRequested Decimal   @map("days_requested") @db.Decimal(5,2)
  reason        String?
  status        String    @default("pending") // pending | approved | rejected | cancelled
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model PayrollRun {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  periodName    String    @map("period_name")
  periodStart   DateTime  @map("period_start") @db.Date
  periodEnd     DateTime  @map("period_end") @db.Date
  status        String    @default("queued") // queued | processing | completed | failed
  initiatedBy   String    @map("initiated_by") @db.Uuid
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  employeeCount Int?      @map("employee_count")
  totalGross    Decimal?  @map("total_gross") @db.Decimal(20,6)
  totalNet      Decimal?  @map("total_net") @db.Decimal(20,6)
  errorLog      Json?     @map("error_log")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [initiatedBy], references: [id])
  payslips      Payslip[]

  @@map("payroll_runs")
}

model Payslip {
  id           String     @id @default(uuid()) @db.Uuid
  payrollRunId String     @map("payroll_run_id") @db.Uuid
  employeeId   String     @map("employee_id") @db.Uuid
  grossPay     Decimal    @map("gross_pay") @db.Decimal(20,6)
  netPay       Decimal    @map("net_pay") @db.Decimal(20,6)
  deductions   Json       @default("{}")
  pdfS3Key     String?    @map("pdf_s3_key")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee     Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

// ════════════════════════════════════════════════════════
-- 4. SUPPLY CHAIN MODULE
// ════════════════════════════════════════════════════════

model Vendor {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  address      Json?
  paymentTerms Int             @default(30) @map("payment_terms")
  currency     String          @default("USD") @db.Char(3)
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       PurchaseOrder[]

  @@map("vendors")
}

model Warehouse {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  code      String
  name      String
  location  String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels    InventoryLevel[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model InventoryItem {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  sku            String
  name           String
  unitOfMeasure  String           @default("each") @map("unit_of_measure")
  reorderPoint   Decimal          @default(0) @map("reorder_point") @db.Decimal(10,2)
  reorderQty     Decimal          @default(0) @map("reorder_qty") @db.Decimal(10,2)
  unitCost       Decimal          @default(0) @map("unit_cost") @db.Decimal(20,6)
  costingMethod  String           @default("FIFO") @map("costing_method") // FIFO | AVCO
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels         InventoryLevel[]

  @@unique([tenantId, sku])
  @@map("inventory_items")
}

model InventoryLevel {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  itemId        String        @map("item_id") @db.Uuid
  warehouseId   String        @map("warehouse_id") @db.Uuid
  quantity      Decimal       @default(0) @db.Decimal(12,2)
  location      String?
  lastCountedAt DateTime?     @map("last_counted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
  @@map("inventory_levels")
}

model PurchaseOrder {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  vendorId    String         @map("vendor_id") @db.Uuid
  orderNumber String         @map("order_number")
  totalAmount Decimal        @default(0) @map("total_amount") @db.Decimal(20,6)
  status      String         @default("draft") // draft | pending_approval | ordered | delivered
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  receipts    GoodsReceipt[]

  @@unique([tenantId, orderNumber])
  @@map("purchase_orders")
}

model GoodsReceipt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  poId          String        @map("po_id") @db.Uuid
  receiptNumber String        @map("receipt_number")
  receivedAt    DateTime      @default(now()) @map("received_at") @db.Timestamptz
  receivedBy    String        @map("received_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [receivedBy], references: [id])

  @@unique([tenantId, receiptNumber])
  @@map("goods_receipts")
}

// ════════════════════════════════════════════════════════
-- 5. PROJECT MANAGEMENT MODULE
// ════════════════════════════════════════════════════════

model Project {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  budget      Decimal              @default(0) @db.Decimal(20,6)
  spent       Decimal              @default(0) @db.Decimal(20,6)
  status      String               @default("planning") // planning | active | completed
  startDate   DateTime             @map("start_date") @db.Date
  endDate     DateTime?            @map("end_date") @db.Date
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
  tasks       Task[]
  allocations ResourceAllocation[]

  @@unique([tenantId, code])
  @@map("projects")
}

model Milestone {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  dueDate   DateTime @map("due_date") @db.Date
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Task {
  id              String             @id @default(uuid()) @db.Uuid
  projectId       String             @map("project_id") @db.Uuid
  name            String
  description     String?
  assigneeId      String?            @map("assignee_id") @db.Uuid
  status          String             @default("todo") // todo | in_progress | completed
  startDate       DateTime?          @map("start_date") @db.Date
  endDate         DateTime?          @map("end_date") @db.Date
  budgetAllocated Decimal?           @default(0) @map("budget_allocated") @db.Decimal(20,6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee        Employee?          @relation(fields: [assigneeId], references: [id])
  dependencies    TaskDependency[]   @relation("TaskDependsOn")
  dependents      TaskDependency[]   @relation("TaskDependent")

  @@map("tasks")
}

model TaskDependency {
  taskId      String @map("task_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  task        Task   @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@map("task_dependencies")
}

model ResourceAllocation {
  id                   String    @id @default(uuid()) @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  projectId            String    @map("project_id") @db.Uuid
  allocationPercentage Decimal   @default(100) @map("allocation_percentage") @db.Decimal(5,2)
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("resource_allocations")
}

// ════════════════════════════════════════════════════════
-- 6. SYSTEM LOGS & PROTOTYPE TABLES
// ════════════════════════════════════════════════════════

model Lead {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  source         String
  company        String
  estimatedValue Decimal  @default(0) @map("estimated_value") @db.Decimal(20,6)
  status         String   @default("new") // new | qualified | contacted
  partition      String   @default("SEC_ALPHA_01")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model TerminalLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  command   String
  output    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("terminal_logs")
}
